<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds only: permit cleartext HTTP to local dev backends.
     Emulator reaches the host machine at 10.0.2.2; a physical device uses the
     host's LAN IP. base-config permits cleartext for any host so whichever dev
     address you point Constants.baseUrl / authBaseUrl at will work in debug.
     Release builds are unaffected (they use HTTPS, no cleartext). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true"/>
</network-security-config>
